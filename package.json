    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "jsonrepair": "^3.12.0",
    "katex": "^0.16.22",
    "konva": "^10.3.0",
    "lucide-react": "^0.447.0",
