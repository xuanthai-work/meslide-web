{
  "name": "gslide-web",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev ",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 19",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit",
    "deadcode": "knip --include files,dependencies,unlisted --reporter compact",
    "check": "npm test && npm run lint && npm run typecheck && npm run deadcode",
    "test": "node --test tests/*.test.mjs",
    "test:export-output-path": "node --test tests/export-output-path.test.mjs",
    "test:layout-code": "node --test tests/layout-code-validator.test.mjs",
    "check:layout-code": "node --test tests/layout-code-validator.test.mjs",
    "watch:task": "powershell -ExecutionPolicy Bypass -File ../scripts/watch-and-inject.ps1"
  },
