# Copy this file to .env (Compose reads .env next to docker-compose.yml):
#   copy .env.example .env
#
# Start FastAPI from the gslide-api checkout first (same Docker network
# `gslide`), then:
#   docker compose up --build web
# Dev with hot-reload:
#   docker compose up --build web-dev
#
# App: http://localhost:3000
# After changing .env, recreate the container:
#   docker compose up --build --force-recreate web

# Browser-facing host port for the Next.js web/BFF service (default 3000).
# GSLIDE_HTTP_HOST_PORT is honored as a legacy alias.
GSLIDE_WEB_HOST_PORT=3000

# In-cluster / Compose DNS name of FastAPI. Override only if api is not
# attached to the shared `gslide` network as service `api`.
FAST_API_INTERNAL_URL=http://api:8000

# Public origin used for canonical/OpenGraph metadata. Set the external HTTPS
# URL in shared environments; evaluated by Next.js at request time.
# SITE_URL=https://slides.example.com

# Retained presentation features. Community depends on Smart mode, so both
# values must be true to expose Community UI. Defaults preserve current UI.
GSLIDE_FEATURE_SMART_MODE=false
GSLIDE_FEATURE_COMMUNITY=false
# When enabled, Rewrite with AI uploads/decomposes selected documents first
# and grounds the rewritten prompt in their extracted content.
GSLIDE_FEATURE_DOCUMENT_AWARE_REWRITE=false

# linux/amd64 (default) | linux/arm64
# GSLIDE_DOCKER_PLATFORM=linux/amd64
