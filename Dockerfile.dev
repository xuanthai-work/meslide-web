# syntax=docker/dockerfile:1.4
FROM node:20-bookworm-slim

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci

EXPOSE 3000
# node_modules lives in a named volume (bind-mounted source), so it can lag
# behind package.json/package-lock.json after a dependency change. Reinstall
# whenever the lockfile hash differs from the last successful install.
CMD ["sh", "-c", "LOCK_HASH=$(sha256sum package-lock.json | cut -d' ' -f1); if [ ! -x node_modules/.bin/next ] || [ \"$(cat node_modules/.deps-hash 2>/dev/null)\" != \"$LOCK_HASH\" ]; then npm ci && printf '%s' \"$LOCK_HASH\" > node_modules/.deps-hash; fi; exec npx next dev -H 0.0.0.0 -p 3000"]